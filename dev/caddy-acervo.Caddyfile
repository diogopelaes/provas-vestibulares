acervo.diogo.mat.br {
    encode zstd gzip

    handle_path /static/* {
        root * /var/www/provas-vestibulares/staticfiles
        file_server
    }

    handle_path /media/* {
        root * /var/www/provas-vestibulares/media
        file_server
    }

    handle {
        reverse_proxy localhost:9003
    }
}
