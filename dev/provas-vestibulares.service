[Unit]
Description=Gunicorn daemon for Provas de Vestibulares (acervo.diogo.mat.br)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/provas-vestibulares
EnvironmentFile=-/var/www/provas-vestibulares/.env
ExecStart=/var/www/provas-vestibulares/.venv/bin/gunicorn \
          --workers 3 \
          --bind 127.0.0.1:9003 \
          --access-logfile - \
          --error-logfile - \
          core.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

